{
  "private": false,
  "name": "@e-infra/design-system",
  "version": "0.2.0",
  "keywords": [
    "react",
    "design system",
    "typescript",
    "shadcn",
    "tailwind",
    "e-infra"
  ],
  "description": "e-INFRA CZ Design System - A comprehensive React component library built with shadcn/ui and Tailwind CSS",
  "author": {
    "name": "CERIT-SC, Masaryk University",
    "email": "root@cerit-sc.cz",
    "url": "https://www.cerit-sc.cz"
  },
  "maintainers": [
    "Jakub Čillík <cillik@muni.cz>",
    "Romana Ďuráčiová <duraciova@mail.muni.cz>",
    "Michal Mikuš <mikus@mail.muni.cz>"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CERIT-SC/design-system.git"
  },
  "bugs": {
    "url": "https://github.com/CERIT-SC/design-system/issues"
  },
  "homepage": "https://github.com/CERIT-SC/design-system",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "dev:showcase": "next dev",
    "build:showcase": "next build && bun run build:search",
    "build:search": "node scripts/build-search-index.mjs",
    "preview:showcase": "next start",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "build:lib": "tsc -b && vite build --config vite.config.lib.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"lib/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"lib/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type:check": "bun run typecheck:lib && bun run typecheck:showcase && bun run typecheck:stories",
    "typecheck:lib": "tsc --noEmit --project tsconfig.lib.json",
    "typecheck:showcase": "tsc --noEmit --project tsconfig.next.json",
    "typecheck:stories": "tsc --noEmit --project tsconfig.stories.json",
    "tsc": "tsc --noEmit --watch",
    "check:ai-manual": "node scripts/check-ai-manual.mjs",
    "check": "bun run type:check && bun run lint && bun run format:check && bun run check:ai-manual"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./setup.css": "./dist/setup.css",
    "./eosc_setup.css": "./dist/eosc_setup.css",
    "./elter_setup.css": "./dist/elter_setup.css",
    "./custom_setup.css": "./dist/custom_setup.css"
  },
  "packageManager": "bun@1.4.0",
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.70.0",
    "next-mdx-remote": "^6.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@radix-ui/react-slot": "^1.5.0",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/react": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "next": "^16.4.5",
    "pagefind": "^1.6.0",
    "prettier": "3.8.0",
    "rollup-preserve-directives": "^1.1.3",
    "storybook": "^10.6.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "@radix-ui/react-accordion": "^1.0.0",
    "@radix-ui/react-alert-dialog": "^1.0.0",
    "@radix-ui/react-aspect-ratio": "^1.0.0",
    "@radix-ui/react-avatar": "^1.0.0",
    "@radix-ui/react-checkbox": "^1.0.0",
    "@radix-ui/react-collapsible": "^1.0.0",
    "@radix-ui/react-context-menu": "^2.0.0",
    "@radix-ui/react-dialog": "^1.0.0",
    "@radix-ui/react-dropdown-menu": "^2.0.0",
    "@radix-ui/react-label": "^2.0.0",
    "@radix-ui/react-menubar": "^1.0.0",
    "@radix-ui/react-navigation-menu": "^1.0.0",
    "@radix-ui/react-popover": "^1.0.0",
    "@radix-ui/react-progress": "^1.0.0",
    "@radix-ui/react-radio-group": "^1.0.0",
    "@radix-ui/react-scroll-area": "^1.0.0",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.0",
    "@radix-ui/react-slider": "^1.0.0",
    "@radix-ui/react-slot": "^1.0.0",
    "@radix-ui/react-switch": "^1.0.0",
    "@radix-ui/react-tabs": "^1.0.0",
    "@radix-ui/react-toggle": "^1.0.0",
    "@radix-ui/react-toggle-group": "^1.0.0",
    "@radix-ui/react-tooltip": "^1.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.0.0",
    "react-resizable-panels": "^4.0.0",
    "recharts": "^3.6.0",
    "sonner": "^1.0.0 || ^2.0.0",
    "tailwind-merge": "^2.0.0 || ^3.0.0",
    "tailwindcss": "^4.0.0"
  }
}